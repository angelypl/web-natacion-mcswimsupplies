# Copia este archivo a `.env.local` y ajusta los valores. Nunca subas `.env*` a git.

# URL base del sistema de gestión de clases (repo mcswim-admin), sin barra final.
# La home lee de ahí los horarios activos: GET ${ADMIN_API_URL}/api/public/schedules
# En local, con mcswim-admin corriendo en el puerto 3001:
ADMIN_API_URL="http://localhost:3001"
