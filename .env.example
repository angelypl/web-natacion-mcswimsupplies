# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
#
# Local dev with Docker (avoid ports already used by a local Postgres install
# on your machine — check with a port scanner before picking one):
#   docker run --name mcswim-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=mcswim -p 55432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/mcswim"
